default_platform(:ios)

APP_IDENTIFIER = "com.mission365.app"

platform :ios do
  desc "Build, sign, and upload Mission 365 to TestFlight without manual Xcode upload"
  lane :beta do
    %w[ASC_KEY_ID ASC_ISSUER_ID APPLE_TEAM_ID IOS_PROFILE_NAME].each do |name|
      UI.user_error!("Missing required #{name}") if ENV[name].to_s.strip.empty?
    end

    key_path = ENV["ASC_KEY_PATH"].to_s.strip
    key_content = ENV["ASC_KEY_CONTENT"].to_s
    UI.user_error!("Missing ASC_KEY_PATH or ASC_KEY_CONTENT") if key_path.empty? && key_content.strip.empty?
    UI.user_error!("Capacitor CocoaPods workspace is missing") unless File.exist?("App.xcworkspace/contents.xcworkspacedata")

    api_key_options = {
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      duration: 1200,
      in_house: false
    }
    if !key_path.empty?
      api_key_options[:key_filepath] = key_path
    else
      api_key_options[:key_content] = key_content
      api_key_options[:is_key_content_base64] = false
    end
    api_key = app_store_connect_api_key(**api_key_options)

    build_number = Time.now.utc.strftime("%Y%m%d%H%M%S")
    increment_build_number(build_number: build_number, xcodeproj: "App.xcodeproj")

    team_id = ENV["APPLE_TEAM_ID"].to_s.strip
    profile_name = ENV["IOS_PROFILE_NAME"].to_s.strip
    signing_args = [
      "DEVELOPMENT_TEAM=#{team_id}",
      "CODE_SIGN_STYLE=Manual",
      "CODE_SIGN_IDENTITY='iPhone Distribution'",
      "PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'"
    ]

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      export_team_id: team_id,
      export_options: {
        method: "app-store-connect",
        signingStyle: "manual",
        signingCertificate: "iPhone Distribution",
        teamID: team_id,
        provisioningProfiles: { APP_IDENTIFIER => profile_name },
        uploadSymbols: true
      },
      clean: true,
      output_directory: "./build",
      output_name: "mission-365.ipa",
      xcargs: signing_args.join(" "),
      disable_package_automatic_updates: true,
      skip_profile_detection: true,
      result_bundle: true
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false,
      changelog: ENV.fetch("TESTFLIGHT_CHANGELOG", "Automated Mission 365 production candidate")
    )

    UI.success("Mission 365 uploaded to TestFlight")
  end
end
