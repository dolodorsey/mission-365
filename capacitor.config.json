{
  "appId": "com.mission365.app",
  "appName": "Mission 365",
  "webDir": "native-shell",
  "server": {
    "url": "https://mission-365.vercel.app",
    "cleartext": false,
    "androidScheme": "https",
    "iosScheme": "https",
    "allowNavigation": ["mission-365.vercel.app"]
  },
  "ios": {
    "backgroundColor": "#050816",
    "contentInset": "always",
    "preferredContentMode": "mobile",
    "scheme": "Mission365"
  },
  "android": {
    "backgroundColor": "#050816",
    "allowMixedContent": false
  },
  "plugins": {
    "StatusBar": { "style": "DARK", "backgroundColor": "#050816" },
    "SplashScreen": {
      "launchShowDuration": 1800,
      "launchAutoHide": true,
      "backgroundColor": "#050816",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}
